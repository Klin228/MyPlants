# Образец локального окружения. Значений здесь нет и быть не должно.
#
# Не заполняйте этот файл руками — он коммитится в репозиторий.
# Настоящие ключи приезжают из Vercel:
#
#   vercel link
#   vercel env pull .env.local
#
# .env.local закрыт правилом `.env*.local` в .gitignore. Этот образец под него
# не попадает: он оканчивается на .example, а не на .local.

# Токен блоб-хранилища. Появляется после Storage → Create → Blob в панели проекта.
BLOB_READ_WRITE_TOKEN=

# Строка подключения к Neon. Появляется после Storage → Marketplace → Neon.
# vercel env pull притащит рядом ещё несколько POSTGRES_* и DATABASE_URL_UNPOOLED —
# они не мешают, приложение использует DATABASE_URL.
DATABASE_URL=
